---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Hero from '../components/Hero.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

const getProjectStartDate = (period: string) => period.match(/^(\d{4})\.(\d{2})\.(\d{2})/)
  ? Date.parse(period.slice(0, 10).replaceAll('.', '-'))
  : 0;
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => getProjectStartDate(b.data.period) - getProjectStartDate(a.data.period),
);
const internCareer = profile.career.find((item) => item.company === '아크릴');
const coreSkills = new Set<string>(profile.coreSkills);
---

<BaseLayout home>
  <Hero />

  <section class="section">
    <div id="career" class="container career-section">
    <div class="section-heading">
      <p class="section-kicker">경력</p>
      <h2>기술을 실제 업무에 연결합니다.</h2>
      <ul class="career-focus" aria-label="현재 집중 업무">
        <li>전력산업 R&amp;D 과제·사업</li>
        <li>폐쇄망 AI 서비스</li>
        <li>기획·설계·개발</li>
      </ul>
    </div>
    <div class="timeline">
      {profile.career.map((item, index) => (
        <article>
          <div class="timeline-marker"><span>{String(index + 1).padStart(2, '0')}</span></div>
          <div class="timeline-period">{item.period}</div>
          <div class="timeline-content">
            <h3>{item.company}</h3>
            <p class="career-role">{item.team} · {item.role}</p>
            <p>{item.description}</p>
            {item.highlights.length > 0 && <ul class="career-highlights">{item.highlights.map((line) => <li>{line}</li>)}</ul>}
          </div>
        </article>
      ))}
    </div>
    </div>
  </section>

  <section id="projects" class="section section--alt">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">프로젝트</p>
          <h2>문제를 정의하여 서비스로 연결</h2>
        </div>
      </div>
      <div class="intern-projects">
        <div class="intern-head">
          <h3>인턴 기간 참여 프로젝트</h3>
          <p>{internCareer?.company} · {internCareer?.role} · {internCareer?.period}.</p>
        </div>
        <ol class="intern-list">
          {profile.internProjects.map((item) => (
            <li><span class="intern-num">{item.number}</span><strong>{item.title}</strong><span class="intern-sub">{item.subtitle}</span></li>
          ))}
        </ol>
      </div>
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div id="skills" class="container skills-section">
    <div class="section-heading">
      <p class="section-kicker">기술 역량</p>
      <h2>다음의 기술들을 활용하여 <span class="keep">AI 서비스를</span> 개발하였습니다.</h2>
      <p>진한 항목들이 가장 자주 사용하는 것들입니다.</p>
    </div>
    <div class="skill-grid">
      {profile.skills.map((skill, index) => (
        <article class="skill-card" data-reveal="skill">
          <div class="skill-index">0{index + 1}</div>
          <h3>{skill.group}</h3>
          <p class="skill-summary">{skill.description}</p>
          <ul>{skill.items.map((item) => <li class:list={{ 'is-core': coreSkills.has(item) }}>{item}</li>)}</ul>
        </article>
      ))}
    </div>
    </div>
  </section>

  <section class="intro-band section--alt">
    <div class="container intro-grid">
      <p class="section-kicker">일하는 방식</p>
      <p class="intro-copy">{profile.introduction}</p>
      <div class="workflow-grid">
        {profile.workflow.map((item) => (
          <article data-reveal="workflow">
            <span>{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div id="resume" class="container">
      <div class="section-heading">
        <p class="section-kicker">이력 사항</p>
        <h2>학력, 활동, 자격과 수상.</h2>
      </div>
      <div class="resume-grid">
        <div class="resume-col">
          <h3>Education</h3>
          <ul>{profile.education.map((item) => <li><span class="resume-date">{item.period}</span><span>{item.title}</span></li>)}</ul>
        </div>
        <div class="resume-col">
          <h3>Activities</h3>
          <ul>{profile.activities.map((item) => <li><span class="resume-date">{item.period}</span><span>{item.title}</span></li>)}</ul>
        </div>
        <div class="resume-col">
          <h3>Certification / Awards</h3>
          <ul>{profile.awards.map((item) => <li><span class="resume-date">{item.date}</span><span>{item.title}</span></li>)}</ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .keep { white-space: nowrap; }
  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(2rem, 5vw, 4rem) var(--space-8); }
  /* 인턴 프로젝트(최신)가 카드보다 먼저. 흰 섹션 위라 바탕은 Slate 50 */
  .intern-projects { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 5rem); margin-bottom: clamp(3rem, 6vw, 5rem); padding: var(--space-6) var(--space-6); border-left: 3px solid var(--accent-bar); background: var(--bg-page); border-radius: 0 var(--radius-md) var(--radius-md) 0; }
  .intern-head h3 { margin-bottom: var(--space-2); font-size: 1.15rem; }
  .intern-head p { margin: 0; color: var(--text-secondary); font-size: 0.92rem; }
  .intern-list { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--space-2); }
  .intern-list li { display: grid; grid-template-columns: 2rem minmax(0, 11rem) 1fr; gap: var(--space-3); align-items: baseline; padding-block: var(--space-2); }
  .intern-list li + li { border-top: 1px solid var(--border-hair); }
  .intern-num { color: var(--text-accent); font-family: var(--font-mono); font-size: var(--font-size-utility); font-weight: 600; }
  .intern-sub { color: var(--text-secondary); font-size: 0.92rem; }

  .intro-band { padding-block: clamp(4rem, 8vw, 7rem); }
  .intro-copy { max-width: 62rem; margin-bottom: clamp(2.5rem, 6vw, 5rem); color: var(--text-primary); font-size: clamp(1.5rem, 3.4vw, 2.6rem); line-height: 1.42; letter-spacing: -0.03em; }
  .workflow-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
  .workflow-grid article { min-height: 14rem; padding: var(--space-5); border-left: 3px solid var(--accent-bar); border-radius: 0 var(--radius-md) var(--radius-md) 0; background: var(--bg-page); }
  .workflow-grid span { color: var(--text-accent); font-family: var(--font-mono); font-size: var(--font-size-utility); font-weight: 600; }
  .workflow-grid h3 { margin-top: var(--space-12); }
  .workflow-grid p { margin-bottom: 0; color: var(--text-secondary); font-size: 0.9rem; }

  .career-section { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(3rem, 7vw, 7rem); }
  .career-focus { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-6) 0 0; padding: 0; list-style: none; }
  .career-focus li { padding: 0.35rem 0.65rem; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); color: var(--text-secondary); font-size: var(--font-size-utility); font-weight: 650; }
  .timeline article { display: grid; grid-template-columns: 3rem 9rem 1fr; gap: var(--space-4); padding: var(--space-8) 0; }
  .timeline article + article { border-top: 1px solid var(--border-hair); }
  .timeline article:first-child { padding-top: var(--space-2); }
  .timeline-marker span { color: var(--text-accent-secondary); font-family: var(--font-mono); font-size: var(--font-size-utility); }
  /* 날짜 + '현재' 같은 한글이 섞이므로 Pretendard, 숫자 폭은 고정 */
  .timeline-period { color: var(--text-muted); font-family: var(--font-sans); font-size: var(--font-size-utility); font-weight: 600; font-variant-numeric: tabular-nums; }
  .timeline-content h3 { margin-bottom: var(--space-1); }
  .career-role { color: var(--text-secondary); font-weight: 700; }
  .timeline-content p { color: var(--text-secondary); }
  .timeline-content p:last-of-type { margin-bottom: 0; }
  .career-highlights { margin: var(--space-3) 0 0; padding-left: 1.1rem; color: var(--text-secondary); font-size: 0.92rem; display: grid; gap: var(--space-1); }

  .resume-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2rem, 4vw, 3.5rem); }
  .resume-col h3 { margin-bottom: var(--space-3); padding-bottom: var(--space-2); border-bottom: 1px solid var(--border-hair); font-family: var(--font-mono); font-size: var(--font-size-utility); font-weight: 600; letter-spacing: 0; color: var(--text-accent); }
  .resume-col ul { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--space-3); }
  .resume-col li { display: grid; gap: 2px; font-size: 0.95rem; font-weight: 600; }
  .resume-date { color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-utility); font-weight: 400; }

  .skill-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(2rem, 4vw, 3.5rem); }
  .skill-card { display: flex; min-height: 20rem; flex-direction: column; }
  .skill-index { color: var(--text-accent-secondary); font-family: var(--font-mono); font-size: var(--font-size-utility); font-weight: 600; }
  .skill-card h3 { margin: var(--space-8) 0 var(--space-3); }
  .skill-summary { min-height: 4.4em; margin-bottom: var(--space-5); color: var(--text-secondary); font-size: 0.95rem; line-height: 1.65; }
  .skill-card ul { margin: auto 0 0; padding: 0; list-style: none; }
  .skill-card li { padding-block: 0.3rem; color: var(--text-secondary); font-family: var(--font-sans); font-size: 0.9rem; font-weight: 600; }
  .skill-card li.is-core { display: flex; align-items: center; gap: var(--space-2); color: var(--text-primary); font-weight: 750; }
  .skill-card li.is-core::before { content: ""; width: 14px; height: 3px; background: var(--accent-bar); flex: 0 0 auto; }
  @media (max-width: 54rem) {
    .career-section, .intern-projects { grid-template-columns: 1fr; }
    .workflow-grid { grid-template-columns: repeat(2, 1fr); }
    .skill-grid, .resume-grid { grid-template-columns: 1fr; }
    .skill-card { min-height: auto; }
    .skill-summary { min-height: auto; }
  }
  @media (max-width: 44rem) {
    .project-grid { grid-template-columns: 1fr; }
    .workflow-grid { grid-template-columns: 1fr; }
    .workflow-grid article { min-height: auto; }
    .timeline article { grid-template-columns: 2rem 1fr; }
    .timeline-period { grid-column: 2; grid-row: 1; }
    .timeline-content { grid-column: 2; }
    .intern-list li { grid-template-columns: 2rem 1fr; }
    .intern-sub { grid-column: 2; }
  }
</style>
