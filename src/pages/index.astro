---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

const getProjectStartDate = (period: string) => period.match(/^(\d{4})\.(\d{2})\.(\d{2})/)
  ? Date.parse(period.slice(0, 10).replaceAll('.', '-'))
  : 0;
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => getProjectStartDate(b.data.period) - getProjectStartDate(a.data.period),
);
---

<BaseLayout home>
  <section id="about" class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">Moon Seung Gi · AI Engineer</p>
      <h1><span class="hero-prefix">AI를 기능이 아닌</span> <span>작동하는 구조</span>로 만듭니다.</h1>
      <p class="hero-description">{profile.headline}</p>
      <div class="hero-actions">
        <a class="button" href="#projects">프로젝트 보기 ↓</a>
        <button class="button secondary" type="button" data-email-dialog-open>이메일 주소 보기</button>
      </div>
    </div>
    <aside class="hero-profile surface" aria-label="프로필 요약">
      <div class="profile-visual" aria-hidden="true">
        <span>MS</span>
        <i></i><i></i><i></i>
      </div>
      <div class="profile-content">
        <h2>{profile.name}</h2>
        <p>{profile.englishName}</p>
        <dl>
          <div><dt>전문 분야</dt><dd>LLM · RAG · Agent</dd></div>
          <div><dt>주요 경험</dt><dd>AI 서비스 기획 · 설계 · 개발</dd></div>
        </dl>
      </div>
    </aside>
  </section>

  <section class="intro-band">
    <div class="container intro-grid">
      <p class="section-kicker section-kicker--inverse">일하는 방식</p>
      <p class="intro-copy">{profile.introduction}</p>
      <div class="workflow-grid">
        {profile.workflow.map((item) => (
          <article>
            <span>{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="career" class="section container career-section">
    <div class="section-heading">
      <p class="section-kicker">경력</p>
      <h2>기술을 업무의 흐름에 연결합니다.</h2>
      <ul class="career-focus" aria-label="현재 집중 업무">
        <li>전력산업 R&amp;D 과제·사업</li>
        <li>폐쇄망 AI 서비스</li>
        <li>기획·설계·개발</li>
      </ul>
    </div>
    <div class="timeline">
      {profile.career.map((item, index) => (
        <article>
          <div class="timeline-marker"><span>{String(index + 1).padStart(2, '0')}</span></div>
          <div class="timeline-period">{item.period}</div>
          <div class="timeline-content">
            <h3>{item.company}</h3>
            <p class="career-role">{item.team} · {item.role}</p>
            <p>{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="projects" class="section projects-section">
    <div class="container">
      <div class="section-heading projects-heading">
        <div>
          <p class="section-kicker">프로젝트</p>
          <h2>문제에서 서비스까지.</h2>
        </div>
        <p>최근 작업부터 프로젝트의 배경·구조·기술적 판단을 웹에서 읽기 쉽게 정리했습니다.</p>
      </div>
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section id="skills" class="section container skills-section">
    <div class="section-heading">
      <p class="section-kicker">기술 역량</p>
      <h2>서비스를 만들며 활용하는 기술입니다.</h2>
    </div>
    <div class="skill-grid">
      {profile.skills.map((skill, index) => (
        <article class="skill-card surface">
          <div class="skill-index">0{index + 1}</div>
          <h3>{skill.group}</h3>
          <p class="skill-summary">{skill.description}</p>
          <ul>{skill.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
    <div class="background-compact">
      <div class="background-heading">
        <p class="section-kicker">이력과 활동</p>
        <h2>학습과 프로젝트 경험</h2>
      </div>
      <div class="background-list">
        {profile.education.map((item) => (
          <div><span>{item.label}</span><strong>{item.value}</strong></div>
        ))}
        <div><span>공개 이력서</span><strong>준비 중</strong></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { display: grid; min-height: calc(100svh - var(--header-height)); grid-template-columns: minmax(0, 1.45fr) minmax(20rem, 0.55fr); align-items: center; gap: clamp(2rem, 7vw, 7rem); padding-block: clamp(3rem, 7vw, 7rem); }
  .hero h1 { max-width: 56rem; margin-bottom: var(--space-8); }
  .hero-prefix { white-space: nowrap; }
  .hero h1 span { color: var(--accent-primary); }
  .hero-description { max-width: 43rem; margin-bottom: var(--space-8); color: var(--text-secondary); font-size: clamp(1.05rem, 2vw, 1.25rem); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .hero-profile { overflow: hidden; box-shadow: var(--shadow-emphasis); }
  .profile-visual { position: relative; display: grid; min-height: 20rem; place-items: center; overflow: hidden; background: var(--bg-accent-soft); }
  .profile-visual > span { position: relative; z-index: 2; display: grid; width: 8rem; aspect-ratio: 1; place-items: center; border-radius: 2.5rem; background: var(--accent-primary); color: var(--bg-surface); font-family: var(--font-mono); font-size: 2rem; font-weight: 700; transform: rotate(-5deg); }
  .profile-visual i { position: absolute; border: 1px solid var(--color-indigo-100); border-radius: 50%; }
  .profile-visual i:nth-of-type(1) { width: 16rem; aspect-ratio: 1; }
  .profile-visual i:nth-of-type(2) { width: 22rem; aspect-ratio: 1; }
  .profile-visual i:nth-of-type(3) { width: 29rem; aspect-ratio: 1; }
  .profile-content { padding: var(--space-6); }
  .profile-content h2 { margin-bottom: 0; font-size: 2rem; }
  .profile-content > p { color: var(--text-muted); }
  .profile-content dl { margin: var(--space-6) 0 0; }
  .profile-content dl div { display: grid; grid-template-columns: 4rem 1fr; gap: var(--space-3); padding-block: var(--space-2); border-top: 1px solid var(--border-subtle); }
  dt { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; }
  dd { margin: 0; font-size: 0.84rem; font-weight: 650; }
  .intro-band { padding-block: clamp(4rem, 8vw, 7rem); background: var(--text-primary); color: var(--bg-surface); }
  .intro-copy { max-width: 62rem; margin-bottom: clamp(3rem, 7vw, 6rem); color: color-mix(in srgb, var(--bg-surface) 84%, transparent); font-size: clamp(1.5rem, 3.6vw, 3rem); line-height: 1.42; letter-spacing: -0.03em; }
  .workflow-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-3); }
  .workflow-grid article { min-height: 15rem; padding: var(--space-5); border: 1px solid color-mix(in srgb, var(--bg-surface) 15%, transparent); border-radius: var(--radius-md); background: color-mix(in srgb, var(--bg-surface) 4%, transparent); }
  .workflow-grid span { color: var(--color-indigo-100); font-family: var(--font-mono); font-size: var(--font-size-utility); }
  .workflow-grid h3 { margin-top: var(--space-12); }
  .workflow-grid p { margin-bottom: 0; color: color-mix(in srgb, var(--bg-surface) 62%, transparent); font-size: 0.9rem; }
  .career-section { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(3rem, 7vw, 7rem); }
  .career-focus { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-6) 0 0; padding: 0; list-style: none; }
  .career-focus li { padding: 0.35rem 0.65rem; border: 1px solid var(--border-subtle); border-radius: 999px; color: var(--text-secondary); font-size: var(--font-size-utility); font-weight: 650; }
  .timeline { border-top: 1px solid var(--border-subtle); }
  .timeline article { display: grid; grid-template-columns: 3rem 9rem 1fr; gap: var(--space-4); padding: var(--space-8) 0; border-bottom: 1px solid var(--border-subtle); }
  .timeline-marker span { color: var(--accent-secondary); font-family: var(--font-mono); font-size: var(--font-size-utility); }
  .timeline-period { color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-utility); }
  .timeline-content h3 { margin-bottom: var(--space-1); }
  .career-role { color: var(--accent-primary); font-weight: 700; }
  .timeline-content p:last-child { margin-bottom: 0; color: var(--text-secondary); }
  .projects-section { background: var(--bg-surface); }
  .projects-heading { display: grid; max-width: none; grid-template-columns: 1.1fr 0.9fr; align-items: end; gap: var(--space-12); }
  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(3rem, 7vw, 7rem) var(--space-8); }
  .skill-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .skill-card { display: flex; min-height: 20rem; flex-direction: column; padding: var(--space-6); }
  .skill-index { color: var(--accent-secondary); font-family: var(--font-mono); font-size: var(--font-size-utility); }
  .skill-card h3 { margin: var(--space-8) 0 var(--space-3); }
  .skill-summary { min-height: 4.4em; margin-bottom: var(--space-5); color: var(--text-secondary); font-size: 0.95rem; line-height: 1.65; }
  .skill-card ul { margin: auto 0 0; padding: 0; list-style: none; }
  .skill-card li { padding-block: 0.4rem; border-bottom: 1px solid var(--border-subtle); color: var(--text-secondary); font-family: var(--font-sans); font-size: 0.9rem; font-weight: 600; }
  .background-compact { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(3rem, 7vw, 7rem); margin-top: clamp(4rem, 8vw, 7rem); padding-top: clamp(3rem, 6vw, 5rem); border-top: 1px solid var(--border-subtle); }
  .background-heading .section-kicker { margin-bottom: var(--space-3); }
  .background-heading h2 { max-width: 28rem; font-size: clamp(1.75rem, 3vw, 2.5rem); }
  .background-list { border-top: 1px solid var(--border-subtle); }
  .background-list div { display: grid; grid-template-columns: 7rem 1fr; gap: var(--space-4); padding: var(--space-6) 0; border-bottom: 1px solid var(--border-subtle); }
  .background-list span { color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-utility); }
  @media (max-width: 54rem) {
    .hero, .career-section, .background-compact { grid-template-columns: 1fr; }
    .hero { min-height: auto; }
    .hero-profile { max-width: 30rem; }
    .workflow-grid { grid-template-columns: repeat(2, 1fr); }
    .skill-grid { grid-template-columns: 1fr; }
    .skill-card { min-height: auto; }
    .skill-summary { min-height: auto; }
    .hero-prefix { white-space: normal; }
  }
  @media (max-width: 44rem) {
    .projects-heading, .project-grid { grid-template-columns: 1fr; }
    .workflow-grid { grid-template-columns: 1fr; }
    .workflow-grid article { min-height: auto; }
    .timeline article { grid-template-columns: 2rem 1fr; }
    .timeline-period { grid-column: 2; grid-row: 1; }
    .timeline-content { grid-column: 2; }
    .background-list div { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
