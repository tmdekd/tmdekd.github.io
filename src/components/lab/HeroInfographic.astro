---
/**
 * 모션 랩 변형 2 · 플랫 인포그래픽 (영상 18/30)
 * 우측 프로필 영역을 데이터 카드로. 숫자는 저장소 데이터에서만 계산하고 서버 렌더한다(최종값이 HTML에 존재).
 * JS는 카운트업·막대 상승만 담당한다. 성과·퍼센트 수치는 쓰지 않는다.
 */
import { profile } from '../../data/profile';

interface Props { projectCount: number }
const { projectCount } = Astro.props;

const careerCount = profile.career.length;
const workflowCount = profile.workflow.length;
const skillItemCount = profile.skills.reduce((sum, group) => sum + group.items.length, 0);
const maxItems = Math.max(...profile.skills.map((group) => group.items.length));
const stats = [
  { label: '공개 프로젝트', value: projectCount, unit: '건', source: '프로젝트 컬렉션' },
  { label: '경력', value: careerCount, unit: '곳', source: '경력 데이터' },
  { label: '작업 단계', value: workflowCount, unit: '단계', source: '일하는 방식' },
  { label: '기술 항목', value: skillItemCount, unit: '개', source: '기술 역량 목록' },
];
const barsLabel = profile.skills.map((group) => `${group.group} ${group.items.length}개`).join(', ');
---

<section class="lab-hero" data-lab="infographic" aria-label="플랫 인포그래픽 히어로 시안">
  <div class="hero container">
    <div class="hero-copy">
      <p class="eyebrow" data-hero-anim>Moon Seung Gi · AI Engineer</p>
      <h1 data-hero-anim><span class="hero-prefix">AI를 기능이 아닌</span> <span>작동하는 구조</span>로 만듭니다.</h1>
      <p class="hero-description" data-hero-anim>{profile.headline}</p>
      <div class="hero-actions" data-hero-anim>
        <a class="button" href="#projects">프로젝트 보기 ↓</a>
        <button class="button secondary" type="button">이메일 주소 보기</button>
      </div>
    </div>
    <aside class="hero-profile stats" aria-label="프로필 요약과 공개 데이터 수치">
      <div class="profile-content">
        <h2>{profile.name}</h2>
        <p>{profile.englishName}</p>
      </div>
      <dl class="stat-grid">
        {stats.map((stat) => (
          <div data-hero-anim>
            <dt>{stat.label}</dt>
            <dd><span class="stat-number" data-count={stat.value}>{stat.value}</span><span class="stat-unit">{stat.unit}</span><small class="stat-source">{stat.source} 기준</small></dd>
          </div>
        ))}
      </dl>
      <div class="bars" role="img" aria-label={`기술 그룹별 항목 수: ${barsLabel}`}>
        {profile.skills.map((group) => (
          <div class="bar" data-hero-anim>
            <span class="bar-label"><span>{group.group}</span><b>{group.items.length}</b></span>
            <span class="bar-track" aria-hidden="true"><span class="bar-fill" data-bar={group.items.length / maxItems} style={`--w: ${group.items.length / maxItems}`}></span></span>
          </div>
        ))}
      </div>
      <p class="stats-note">숫자는 이 사이트의 공개 데이터에서 계산됩니다.</p>
    </aside>
  </div>
  <div class="container lab-controls">
    <button class="button secondary" type="button" data-replay>다시 재생</button>
    <p class="lab-status" role="status" aria-live="polite"></p>
  </div>
</section>

<style>
  .stats { border-top: 0; }
  .stats .profile-content { padding-top: 0; }
  .stat-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); margin: var(--space-5) 0 0; }
  .stat-grid > div { padding: var(--space-4); border: 1px solid var(--border-on-inverse); border-left: 3px solid var(--accent-primary); border-radius: 0 var(--radius-md) var(--radius-md) 0; background: var(--surface-on-inverse); }
  .stat-grid dt { margin-bottom: var(--space-2); }
  .stat-grid dd { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem; font-size: 2.2rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1; }
  .stat-number { font-variant-numeric: tabular-nums; min-width: 1.2ch; }
  .stat-unit { font-size: 0.95rem; font-weight: 600; color: var(--text-hero-muted); }
  .stat-source { flex-basis: 100%; margin-top: var(--space-2); color: var(--text-hero-muted); font-size: 0.72rem; font-weight: 400; letter-spacing: 0; line-height: 1.4; }
  .bars { display: grid; gap: var(--space-2); margin-top: var(--space-5); }
  .bar-label { display: flex; justify-content: space-between; font-size: var(--font-size-utility); font-weight: 600; color: var(--text-hero-muted); }
  .bar-label b { color: var(--text-hero); }
  .bar-track { display: block; height: 6px; margin-top: 4px; background: var(--border-on-inverse); }
  .bar-fill { display: block; width: calc(var(--w) * 100%); height: 100%; background: var(--accent-primary); transform-origin: left center; }
  .stats-note { margin: var(--space-4) 0 0; color: var(--text-hero-muted); font-size: 0.78rem; }
  .lab-controls { display: flex; align-items: center; gap: var(--space-4); padding-bottom: var(--space-8); }
  .lab-status { margin: 0; color: var(--text-hero-muted); font-size: 0.9rem; }
</style>

<script>
  import { animate, stagger, claim, EASE_OUT } from '../../scripts/motion/reduced';

  const root = document.querySelector<HTMLElement>('[data-lab="infographic"]');
  if (root) {
    const copy = Array.from(root.querySelectorAll<HTMLElement>('.hero-copy [data-hero-anim]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.stat-grid [data-hero-anim]'));
    const bars = Array.from(root.querySelectorAll<HTMLElement>('.bar[data-hero-anim]'));
    const status = root.querySelector<HTMLElement>('.lab-status');

    const run = () => {
      if (!claim([...copy, ...cards, ...bars])) {
        if (status) status.textContent = '감속 모션 설정이 켜져 있어 애니메이션 없이 최종 화면을 보여줍니다.';
        return;
      }
      animate(copy, { opacity: [0, 1], y: [12, 0] }, { duration: 0.5, delay: stagger(0.08), ease: EASE_OUT });
      animate(cards, { opacity: [0, 1], y: [16, 0] }, { duration: 0.5, delay: stagger(0.1, { startDelay: 0.3 }), ease: EASE_OUT });
      cards.forEach((card, index) => {
        const number = card.querySelector<HTMLElement>('[data-count]');
        if (!number) return;
        const target = Number(number.dataset.count);
        animate(0, target, { duration: 1.1, delay: 0.3 + index * 0.1, ease: EASE_OUT, onUpdate: (value) => { number.textContent = String(Math.round(value)); } });
      });
      bars.forEach((bar, index) => {
        const fill = bar.querySelector<HTMLElement>('.bar-fill');
        animate(bar, { opacity: [0, 1] }, { duration: 0.3, delay: 0.9 + index * 0.1 });
        if (fill) animate(fill, { scaleX: [0, 1] }, { duration: 0.7, delay: 0.9 + index * 0.1, ease: EASE_OUT });
      });
    };

    run();
    root.querySelector('[data-replay]')?.addEventListener('click', run);
  }
</script>
