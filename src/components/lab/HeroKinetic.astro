---
/**
 * 모션 랩 변형 1 · 키네틱 타이포 (영상 01/30)
 * 헤드라인을 빌드 시 단어 단위 span으로 나누고 줄 단위로 슬라이드업 + 페이드.
 * `.hero-prefix`(nowrap)는 단어 래퍼 바깥에 유지한다.
 */
import { profile } from '../../data/profile';

const prefixWords = ['AI를', '기능이', '아닌'];
const restWords = ['작동하는', '구조로', '만듭니다.'];
---

<section class="lab-hero" data-lab="kinetic" aria-label="키네틱 타이포 히어로 시안">
  <div class="hero container">
    <div class="hero-copy">
      <p class="eyebrow" data-hero-anim>Moon Seung Gi · AI Engineer</p>
      <h1 class="kinetic-headline">
        <span class="hero-prefix">{prefixWords.map((word, index) => <>{index > 0 && ' '}<span class="w" data-hero-anim>{word}</span></>)}</span>
        {restWords.map((word) => <>{' '}<span class="w" data-hero-anim>{word}</span></>)}
      </h1>
      <span class="kinetic-rule" aria-hidden="true"></span>
      <p class="hero-description" data-hero-anim>{profile.headline}</p>
      <div class="hero-actions" data-hero-anim>
        <a class="button" href="#projects">프로젝트 보기 ↓</a>
        <button class="button secondary" type="button">이메일 주소 보기</button>
      </div>
    </div>
    <aside class="hero-profile" aria-label="프로필 요약" data-hero-anim>
      <div class="profile-content">
        <h2>{profile.name}</h2>
        <p>{profile.englishName}</p>
        <dl>
          <div><dt>전문 분야</dt><dd>LLM · RAG · Agent</dd></div>
          <div><dt>주요 경험</dt><dd>AI 서비스 기획 · 설계 · 개발</dd></div>
        </dl>
      </div>
    </aside>
  </div>
  <div class="container lab-controls">
    <button class="button secondary" type="button" data-replay>다시 재생</button>
    <p class="lab-status" role="status" aria-live="polite"></p>
  </div>
</section>

<style>
  .kinetic-headline .w { display: inline-block; will-change: transform, opacity; }
  .kinetic-rule { display: block; width: 6rem; height: 4px; margin: calc(var(--space-8) * -1) 0 var(--space-8); background: var(--accent-primary); transform-origin: left center; }
  .lab-controls { display: flex; align-items: center; gap: var(--space-4); padding-bottom: var(--space-8); }
  .lab-status { margin: 0; color: var(--text-hero-muted); font-size: 0.9rem; }
</style>

<script>
  import { animate, stagger, claim, EASE_OUT } from '../../scripts/motion/reduced';

  const root = document.querySelector<HTMLElement>('[data-lab="kinetic"]');
  if (root) {
    const words = Array.from(root.querySelectorAll<HTMLElement>('.w'));
    const rest = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-anim]:not(.w)'));
    const rule = root.querySelector<HTMLElement>('.kinetic-rule');
    const status = root.querySelector<HTMLElement>('.lab-status');

    const run = () => {
      if (!claim([...words, ...rest])) {
        if (status) status.textContent = '감속 모션 설정이 켜져 있어 애니메이션 없이 최종 화면을 보여줍니다.';
        return;
      }
      const wordsDone = 0.07 * words.length + 0.5;
      if (rule) rule.style.transform = 'scaleX(0)';
      animate(words, { opacity: [0, 1], y: ['0.6em', '0em'] }, { duration: 0.6, delay: stagger(0.07), ease: EASE_OUT });
      if (rule) animate(rule, { scaleX: [0, 1] }, { duration: 0.5, delay: wordsDone - 0.2, ease: EASE_OUT });
      animate(rest, { opacity: [0, 1], y: [12, 0] }, { duration: 0.5, delay: stagger(0.08, { startDelay: wordsDone }), ease: EASE_OUT });
    };

    run();
    root.querySelector('[data-replay]')?.addEventListener('click', run);
  }
</script>
