---
import { profile } from '../data/profile';
---

<footer id="contact" class="site-footer">
  <div class="container footer-card">
    <div>
      <p class="section-kicker section-kicker--inverse">Contact</p>
      <h2>함께 해결할 문제를 이야기해 주세요.</h2>
    </div>
    <div class="contact-list">
      <div class="contact-email"><span>Email</span><button class="button" type="button" data-email-copy aria-describedby="email-copy-status">{profile.contact.email} 복사</button></div>
      <p id="email-copy-status" class="copy-status" role="status" aria-live="polite"></p>
      <a href={profile.contact.github} target="_blank" rel="noreferrer"><span>GitHub</span>github.com/tmdekd</a>
      <a href={profile.contact.velog} target="_blank" rel="noreferrer"><span>Velog</span>velog.io/@tmdekd</a>
      <div class="resume"><span>Resume</span>이력서 준비 중</div>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} Moon Seung Gi</span>
    <a href="#top">맨 위로 ↑</a>
  </div>
</footer>

<style>
  /* Contact는 Slate 900 전면 밴드 */
  .site-footer { padding: clamp(4rem, 8vw, 7rem) 0 var(--space-6); background: var(--bg-inverse); color: var(--text-on-inverse); }
  .footer-card { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); }
  h2 { margin-bottom: 0; }
  .contact-list { display: grid; align-content: start; gap: var(--space-2); }
  .contact-list a, .contact-email, .resume { display: grid; grid-template-columns: 5rem 1fr; gap: var(--space-4); padding: var(--space-3) 0; border-top: 1px solid var(--border-on-inverse); color: var(--text-on-inverse); font-weight: 600; text-align: left; text-decoration: none; }
  .contact-email { align-items: center; }
  .contact-email .button { width: fit-content; min-height: 2.75rem; padding: 0.55rem 1rem; font-size: 0.9rem; overflow-wrap: anywhere; }
  .contact-list span { color: var(--text-on-inverse-muted); font-family: var(--font-mono); font-size: var(--font-size-utility); font-weight: 400; }
  .contact-list a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .copy-status { min-height: 0; margin: 0; color: var(--text-on-inverse-muted); font-size: 0.82rem; }
  .copy-status:not(:empty) { padding-block: var(--space-1); }
  .footer-bottom { display: flex; justify-content: space-between; margin-top: var(--space-12); padding-top: var(--space-5); border-top: 1px solid var(--border-on-inverse); color: var(--text-on-inverse-muted); font-size: 0.8rem; }
  .footer-bottom a { text-decoration: none; }
  @media (max-width: 44rem) {
    .footer-card { grid-template-columns: 1fr; gap: var(--space-8); }
    .contact-list a, .contact-email, .resume { grid-template-columns: 1fr; gap: var(--space-2); overflow-wrap: anywhere; }
  }
</style>
