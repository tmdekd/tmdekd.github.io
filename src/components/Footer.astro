---
import { profile } from '../data/profile';
---

<footer id="contact" class="site-footer">
  <div class="container footer-card">
    <div>
      <p class="section-kicker section-kicker--inverse">연락</p>
      <h2>함께 해결할 문제를 이야기해 주세요.</h2>
    </div>
    <div class="contact-list">
      <button type="button" data-email-copy aria-describedby="email-copy-status"><span>Email</span>{profile.contact.email}</button>
      <p id="email-copy-status" class="copy-status" role="status" aria-live="polite"></p>
      <a href={profile.contact.github} target="_blank" rel="noreferrer"><span>GitHub</span>github.com/tmdekd</a>
      <a href={profile.contact.velog} target="_blank" rel="noreferrer"><span>Velog</span>velog.io/@tmdekd</a>
      <div class="resume"><span>Resume</span>이력서 준비 중</div>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} Moon Seung Gi</span>
    <a href="#top">맨 위로 ↑</a>
  </div>
</footer>

<style>
  .site-footer { padding: var(--space-8) 0 var(--space-6); }
  .footer-card { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); padding: clamp(2rem, 6vw, 5rem); border-radius: var(--radius-xl); background: var(--text-primary); color: var(--bg-surface); }
  h2 { margin-bottom: 0; }
  .contact-list { display: grid; align-content: center; gap: var(--space-3); }
  .contact-list a, .contact-list button, .resume { display: grid; grid-template-columns: 5rem 1fr; gap: var(--space-4); padding: var(--space-3) 0; border: 0; border-bottom: 1px solid color-mix(in srgb, var(--bg-surface) 18%, transparent); background: transparent; color: var(--bg-surface); text-align: left; text-decoration: none; }
  .contact-list span { color: color-mix(in srgb, var(--bg-surface) 62%, transparent); font-family: var(--font-mono); font-size: var(--font-size-utility); }
  .contact-list a:hover, .contact-list button:hover { color: var(--color-indigo-100); cursor: pointer; }
  .copy-status { min-height: 1.7em; margin: 0; color: var(--color-indigo-100); font-size: 0.82rem; }
  .footer-bottom { display: flex; justify-content: space-between; padding-top: var(--space-5); color: var(--text-muted); font-size: 0.8rem; }
  .footer-bottom a { text-decoration: none; }
  @media (max-width: 44rem) {
    .footer-card { grid-template-columns: 1fr; gap: var(--space-8); }
    .contact-list a, .contact-list button, .resume { grid-template-columns: 1fr; gap: 0; overflow-wrap: anywhere; }
  }
</style>
