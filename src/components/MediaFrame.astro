---
import type { MediaAsset } from '../types';
const { asset, label = 'Media' } = Astro.props as { asset: MediaAsset; label?: string };
---

<figure class="media-frame" style={`--media-ratio: ${asset.aspectRatio}`}>
  {asset.type === 'image' && asset.src ? (
    <img src={asset.src} alt={asset.alt} loading="lazy" />
  ) : asset.type === 'video' && asset.src ? (
    <video controls preload="metadata" poster={asset.poster} aria-label={asset.alt}>
      <source src={asset.src} />
      {asset.captionsSrc && <track kind="captions" src={asset.captionsSrc} srclang="ko" label="한국어" default />}
    </video>
  ) : (
    <div class="placeholder" role="img" aria-label={asset.alt}>
      <span class="placeholder-label">{label}</span>
      <svg aria-hidden="true" viewBox="0 0 80 80"><rect x="11" y="15" width="58" height="50" rx="9"></rect><path d="m20 53 14-15 10 10 7-7 10 12"></path><circle cx="52" cy="29" r="5"></circle></svg>
      <strong>미디어 준비 중</strong>
      <span>{asset.caption}</span>
    </div>
  )}
  {asset.type !== 'placeholder' && asset.caption && <figcaption>{asset.caption}</figcaption>}
</figure>

<style>
  .media-frame { margin: 0; overflow: hidden; border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: var(--bg-surface); box-shadow: var(--shadow-emphasis); }
  img, video, .placeholder { width: 100%; aspect-ratio: var(--media-ratio); object-fit: cover; }
  .placeholder { display: grid; place-items: center; align-content: center; gap: var(--space-3); padding: var(--space-8); background: linear-gradient(135deg, var(--bg-accent-soft), var(--bg-secondary-soft)); color: var(--text-secondary); text-align: center; }
  .placeholder svg { width: 4rem; fill: none; stroke: var(--accent-primary); stroke-width: 2; }
  .placeholder strong { color: var(--text-primary); font-size: clamp(1rem, 2vw, 1.3rem); }
  .placeholder span:last-child { max-width: 26rem; font-size: 0.85rem; }
  .placeholder-label { color: var(--accent-primary); font-family: var(--font-mono); font-size: var(--font-size-utility); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  figcaption { padding: var(--space-3) var(--space-4); color: var(--text-muted); font-size: 0.8rem; }
</style>
