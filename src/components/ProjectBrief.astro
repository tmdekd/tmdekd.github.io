---
import type { CollectionEntry } from 'astro:content';

const { project, variant = 'card' } = Astro.props as {
  project: CollectionEntry<'projects'>;
  variant?: 'card' | 'hero';
};
const data = project.data;
---

<section class:list={['project-brief', `project-brief--${variant}`]} data-project-brief aria-label={`${data.title} 프로젝트 개요`}>
  <p class="brief-index">Project {String(data.order).padStart(2, '0')}</p>
  <div class="brief-grid">
    <div>
      <span>역할</span>
      <strong>{data.role}</strong>
    </div>
    <div>
      <span>플랫폼</span>
      <strong>{data.platform}</strong>
    </div>
    <div class="brief-tech">
      <span>핵심 기술</span>
      <ul>
        {data.tech.slice(0, 3).map((tech) => <li>{tech}</li>)}
      </ul>
    </div>
  </div>
  <p class="brief-note">대표 화면 자료 준비 중</p>
</section>

<style>
  .project-brief { display: flex; min-height: 100%; flex-direction: column; justify-content: space-between; padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: linear-gradient(135deg, var(--bg-accent-soft), var(--bg-secondary-soft)); color: var(--text-primary); }
  .brief-index, .project-brief span, .brief-note { color: var(--accent-primary); font-family: var(--font-mono); font-size: var(--font-size-utility); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .brief-index { margin-bottom: var(--space-8); }
  .brief-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
  .brief-grid > div { min-width: 0; padding-top: var(--space-3); border-top: 1px solid color-mix(in srgb, var(--accent-primary) 18%, transparent); }
  .brief-grid span { display: block; margin-bottom: var(--space-2); color: var(--text-muted); }
  .brief-grid strong { display: block; font-size: 0.95rem; line-height: 1.55; overflow-wrap: anywhere; }
  .brief-tech { grid-column: 1 / -1; }
  .brief-tech ul { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .brief-tech li { padding: 0.3rem 0.55rem; border: 1px solid color-mix(in srgb, var(--accent-primary) 20%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--bg-surface) 72%, transparent); color: var(--text-secondary); font-family: var(--font-mono); font-size: var(--font-size-utility); line-height: 1.35; }
  .brief-note { align-self: flex-end; margin: var(--space-8) 0 0; color: var(--text-muted); letter-spacing: 0; text-transform: none; }
  .project-brief--card { border: 0; border-radius: 0; }
  .project-brief--hero { min-height: clamp(20rem, 38vw, 32rem); }
  @media (max-width: 32rem) {
    .brief-grid { grid-template-columns: 1fr; }
    .brief-tech { grid-column: auto; }
  }
</style>
