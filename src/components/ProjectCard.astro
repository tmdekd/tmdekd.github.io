---
import MediaFrame from './MediaFrame.astro';
import ProjectBrief from './ProjectBrief.astro';
import type { CollectionEntry } from 'astro:content';
const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const data = project.data;
---

<article class="project-card" data-period={data.period}>
  <a class="media-link" href={`/projects/${project.id}/`} aria-label={`${data.title} 프로젝트 자세히 보기`}>
    {data.heroMedia.type === 'placeholder'
      ? <ProjectBrief project={project} />
      : <MediaFrame asset={data.heroMedia} label={`Project ${String(data.order).padStart(2, '0')}`} />}
  </a>
  <div class="card-body">
    <div>
      <h3><a href={`/projects/${project.id}/`}>{data.title}</a></h3>
      <p class="subtitle">{data.subtitle}</p>
      <p class="summary">{data.summary}</p>
      <dl class="project-meta">
        <div><dt>기간</dt><dd>{data.period}</dd></div>
        <div><dt>역할</dt><dd>{data.role}</dd></div>
      </dl>
      <ul class="tag-list" aria-label={`${data.title} 기술 스택`}>
        {data.tech.slice(0, 3).map((tech) => <li class="tag">{tech}</li>)}
      </ul>
      <a class="detail-link" href={`/projects/${project.id}/`}>프로젝트 자세히 보기 <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</article>

<style>
  .project-card { min-width: 0; }
  .media-link { display: block; aspect-ratio: 16 / 10; margin-bottom: var(--space-5); color: inherit; text-decoration: none; transition: transform 180ms ease; }
  .media-link:hover { transform: translateY(-5px); }
  .card-body { min-width: 0; }
  h3 { margin-bottom: var(--space-1); }
  h3 a { text-decoration: none; }
  h3 a:hover { color: var(--accent-primary); }
  .subtitle { margin-bottom: var(--space-3); color: var(--accent-primary); font-weight: 700; }
  .summary { margin-bottom: var(--space-5); color: var(--text-secondary); }
  .project-meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); margin: 0 0 var(--space-5); }
  .project-meta div { min-width: 0; padding-top: var(--space-2); border-top: 1px solid var(--border-subtle); }
  dt { margin-bottom: var(--space-1); color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-utility); }
  dd { margin: 0; color: var(--text-secondary); font-size: 0.9rem; font-weight: 650; line-height: 1.5; overflow-wrap: anywhere; }
  .detail-link { display: inline-flex; gap: var(--space-2); margin-top: var(--space-5); color: var(--text-primary); font-weight: 750; text-decoration: none; }
  .detail-link:hover { color: var(--accent-primary); }
  @media (max-width: 32rem) {
    .project-meta { grid-template-columns: 1fr; }
  }
</style>
