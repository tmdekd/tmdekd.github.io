---
import MediaFrame from './MediaFrame.astro';
import ProjectBrief from './ProjectBrief.astro';
import type { CollectionEntry } from 'astro:content';
const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const data = project.data;
---

<article class="project-card" data-period={data.period} data-reveal="project-card">
  <a class="project-card-link" href={`/projects/${project.id}/`} aria-label={`${data.title} 프로젝트 자세히 보기`}>
    <div class="project-card__media">
      {data.heroMedia.type === 'placeholder'
        ? <ProjectBrief project={project} />
        : <MediaFrame asset={data.heroMedia} label={`Project ${String(data.order).padStart(2, '0')}`} mode="card" />}
    </div>
    <div class="project-card__content">
      <h3>{data.title}</h3>
      <p class="subtitle">{data.subtitle}</p>
      <p class="summary">{data.summary}</p>
      <dl class="project-meta">
        <div><dt>기간</dt><dd>{data.period}</dd></div>
        <div><dt>역할</dt><dd>{data.role}</dd></div>
      </dl>
      <ul class="tag-list" aria-label={`${data.title} 기술 스택`}>
        {data.tech.slice(0, 3).map((tech) => <li class="tag">{tech}</li>)}
      </ul>
      <span class="detail-link">프로젝트 자세히 보기 <span aria-hidden="true">↗</span></span>
    </div>
  </a>
</article>

<style>
  /* 흰 카드 + 1px 선, 그림자 없음. 호버는 테두리 색만 */
  /* 같은 줄 카드의 미디어·본문 행 높이를 맞추기 위해 subgrid 사용 */
  .project-card { display: grid; grid-row: span 2; grid-template-rows: subgrid; min-width: 0; overflow: hidden; border: 1px solid var(--border-hair); border-radius: var(--radius-lg); background: var(--bg-surface); transition: border-color var(--motion-interactive); }
  .project-card-link { display: grid; grid-row: span 2; grid-template-rows: subgrid; color: inherit; text-decoration: none; }
  .project-card__media { aspect-ratio: 16 / 10; overflow: hidden; background: var(--bg-page); border-bottom: 1px solid var(--border-hair); }
  .project-card__media:has(.project-brief) { aspect-ratio: auto; }
  .project-card__media :global(.media-frame) { height: 100%; }
  .project-card__content { display: flex; min-width: 0; flex: 1; flex-direction: column; padding: var(--space-6); }
  h3 { margin-bottom: var(--space-1); }
  .subtitle { margin-bottom: var(--space-3); color: var(--text-accent); font-weight: 700; }
  .summary { margin-bottom: var(--space-5); color: var(--text-secondary); }
  .project-meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); margin: 0 0 var(--space-5); }
  .project-meta div { min-width: 0; padding-top: var(--space-2); border-top: 1px solid var(--border-hair); }
  dt { margin-bottom: var(--space-1); color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-utility); }
  dd { margin: 0; color: var(--text-secondary); font-size: 0.9rem; font-weight: 650; line-height: 1.5; overflow-wrap: anywhere; }
  .detail-link { display: inline-flex; gap: var(--space-2); margin-top: auto; padding-top: var(--space-5); color: var(--text-accent); font-weight: 750; text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 2px; }
  @media (hover: hover) and (pointer: fine) {
    .project-card:hover { border-color: var(--card-hover-border); }
  }
  .project-card:focus-within { border-color: var(--card-hover-border); }
  @media (max-width: 32rem) {
    .project-meta { grid-template-columns: 1fr; }
  }
</style>
