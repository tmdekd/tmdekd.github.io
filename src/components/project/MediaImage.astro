---
/**
 * 본문 이미지(원본 포트폴리오 캡처·도식). media-manifest.json에서 폭·높이·대체 텍스트를 가져와 CLS를 막는다.
 * - zoom(기본 true): 이미지를 "크게 보기" 버튼으로 감싸 MediaLightbox 에서 원본 크기로 연다.
 * - fit: 썸네일 비율(예: '16 / 10') 안에 contain. 격자에서 높이를 맞출 때 쓴다.
 * - 세로로 긴 화면(portrait)은 높이(--thumb-h)로 묶어 가로로 나열할 수 있게 한다.
 */
import { getMedia, srcsetOf, SIZES } from '../../data/media';

interface Props {
  src: string;
  alt?: string;
  caption?: string;
  /** 'frame'(기본): 1px 선 + Slate 50 바탕 / 'plain': 선 없음 */
  variant?: 'frame' | 'plain';
  /** 고정 비율 안에 contain (예: 카드 격자) */
  fit?: string;
  loading?: 'lazy' | 'eager';
  zoom?: boolean;
  /** srcset 의 sizes. 기본은 행 안 이미지(최대 40rem) */
  sizes?: string;
}
const { src, alt, caption, variant = 'frame', fit, loading = 'lazy', zoom = true, sizes = SIZES.row } = Astro.props;
const srcset = srcsetOf(src);
const meta = getMedia(src);
const altText = alt ?? meta?.alt ?? '';
const portrait = meta ? meta.height > meta.width * 1.15 : false;
---

<figure class:list={['media-image', `media-image--${variant}`, { 'media-image--fit': fit, 'media-image--portrait': portrait, 'media-image--zoom': zoom }]} style={fit ? `--fit: ${fit}` : undefined}>
  {zoom ? (
    <button class="media-zoom" type="button" data-lightbox-src={src} data-lightbox-alt={altText} data-lightbox-caption={caption} aria-label={`크게 보기: ${altText}`}>
      <img src={src} srcset={srcset} sizes={srcset ? sizes : undefined} alt={altText} width={meta?.width} height={meta?.height} loading={loading} decoding="async" />
      <span class="zoom-badge" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M10 4a6 6 0 1 1 0 12 6 6 0 0 1 0-12Zm0 2v8m-4-4h8M15 15l5 5" /></svg></span>
    </button>
  ) : (
    <img src={src} srcset={srcset} sizes={srcset ? sizes : undefined} alt={altText} width={meta?.width} height={meta?.height} loading={loading} decoding="async" />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .media-image { margin: 0; min-width: 0; --thumb-h: 32rem; }
  .media-image--frame { border: 1px solid var(--border-hair); border-radius: var(--radius-md); overflow: hidden; background: var(--bg-page); }
  .media-image img { display: block; width: 100%; height: auto; }
  .media-image--portrait img { max-height: var(--thumb-h); width: auto; max-width: 100%; margin-inline: auto; }
  .media-image--fit img { aspect-ratio: var(--fit); object-fit: contain; width: 100%; height: auto; max-height: none; }
  .media-zoom { position: relative; display: block; width: 100%; min-height: 2.75rem; padding: 0; border: 0; background: transparent; color: inherit; cursor: zoom-in; text-align: inherit; }
  .media-zoom:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: -2px; }
  .zoom-badge { position: absolute; right: var(--space-2); bottom: var(--space-2); display: grid; width: 1.75rem; height: 1.75rem; place-items: center; border: 1px solid var(--border-hair); border-radius: var(--radius-sm); background: var(--bg-surface); color: var(--text-secondary); opacity: 0; transition: opacity 120ms ease; }
  .zoom-badge svg { width: 1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.8; }
  .media-zoom:hover .zoom-badge, .media-zoom:focus-visible .zoom-badge { opacity: 1; }
  @media (hover: none) { .zoom-badge { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .zoom-badge { transition: none; } }
  figcaption { padding: var(--space-2) var(--space-3); border-top: 1px solid var(--border-hair); color: var(--text-muted); font-size: var(--font-size-utility); }
  .media-image--plain figcaption { border-top: 0; padding-inline: 0; }
</style>
