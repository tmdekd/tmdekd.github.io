---
const { home = false } = Astro.props;
const prefix = home ? '' : '/';
---

<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href="/" aria-label="문승기 포트폴리오 홈">
      <span class="brand-mark" aria-hidden="true">MS</span>
      <span>Moon Seung Gi</span>
    </a>
    <button class="menu-toggle" type="button" aria-label="메뉴 열기" aria-controls="primary-navigation" aria-expanded="false" data-menu-toggle>
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <nav id="primary-navigation" aria-label="주요 메뉴" data-mobile-menu data-section-navigation={home ? 'home' : undefined}>
      <a href={`${prefix}#about`}>소개</a>
      <a href={`${prefix}#projects`}>프로젝트</a>
      <a href={`${prefix}#career`}>경력</a>
      <a href={`${prefix}#resume`}>이력</a>
      <a href={`${prefix}#skills`}>기술</a>
      <a class="contact-link" href={`${prefix}#contact`}>Contact</a>
    </nav>
  </div>
</header>

<script is:inline src="/scripts/mobile-menu.js"></script>

<style>
  /* 헤더는 히어로와 같은 Slate 900 한 판. 블러·반투명 없음 */
  .site-header { position: sticky; z-index: 20; top: 0; background: var(--bg-inverse); color: var(--text-on-inverse); }
  .header-inner { position: relative; display: flex; min-height: var(--header-height); align-items: center; justify-content: space-between; gap: var(--space-6); }
  .brand { display: inline-flex; align-items: center; gap: var(--space-3); font-size: 0.86rem; font-weight: 800; text-decoration: none; }
  .brand-mark { display: grid; width: 2.2rem; aspect-ratio: 1; place-items: center; border-radius: var(--radius-sm); background: var(--accent-primary); color: var(--text-on-accent); font-family: var(--font-mono); font-size: var(--font-size-utility); }
  nav { display: flex; align-items: center; gap: clamp(0.75rem, 2.5vw, 2rem); }
  nav a { padding-block: var(--space-1); border-bottom: 2px solid transparent; color: var(--text-on-inverse-muted); font-size: 0.875rem; font-weight: 650; text-decoration: none; }
  nav a:hover, nav a[aria-current="location"] { border-bottom-color: var(--accent-on-inverse); color: var(--text-on-inverse); }
  .menu-toggle { display: none; width: 2.75rem; min-height: 2.75rem; place-items: center; padding: 0; border: 1px solid var(--border-on-inverse); border-radius: var(--radius-sm); background: transparent; color: var(--text-on-inverse); }
  .menu-toggle svg { width: 1.25rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.8; }
  @media (max-width: 42rem) {
    .brand > span:last-child { display: none; }
    .menu-toggle { display: grid; }
    nav { position: absolute; top: calc(100% - var(--space-2)); right: 0; display: none; width: min(18rem, calc(100vw - 1.25rem)); gap: var(--space-1); padding: var(--space-2); border: 1px solid var(--border-on-inverse); border-radius: var(--radius-md); background: var(--bg-inverse); }
    nav[data-open="true"] { display: grid; }
    nav a { display: flex; min-height: 2.75rem; align-items: center; padding: 0.7rem var(--space-3); border: 0; border-left: 3px solid transparent; border-radius: 0; font-size: 0.9rem; }
    nav a:hover, nav a[aria-current="location"] { border-left-color: var(--accent-on-inverse); background: var(--surface-on-inverse); }
  }
</style>
