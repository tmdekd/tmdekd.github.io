---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmailDialog from '../components/EmailDialog.astro';
import '../styles/global.css';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

/**
 * 모션 플래그는 첫 페인트 전에 실행돼야 하므로(히어로 요소 숨김) 동기 스크립트여야 한다.
 * 별도 요청이면 모바일 4G에서 렌더를 ~300ms 막아, 본문을 인라인하고 CSP 에는 그 내용의 sha256 해시만 허용한다(인라인 전면 허용 아님).
 * 원본은 public/scripts/motion-flag.js 에 그대로 두어 내용과 해시가 항상 같이 갱신된다.
 */
// 빌드 시 프로젝트 루트 기준. HTML 파서는 CRLF를 LF로 정규화하므로 해시도 LF 기준으로 계산해야 브라우저와 일치한다
const motionFlagSource = readFileSync(resolve('public/scripts/motion-flag.js'), 'utf8').replaceAll('\r\n', '\n');
const motionFlagHash = createHash('sha256').update(motionFlagSource).digest('base64');

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  image?: string;
  noindex?: boolean;
}

const {
  title = '문승기 · AI Engineer',
  description = 'LLM·RAG·Agent 서비스와 문서 파싱·검색 시스템을 직접 설계하고 만드는 AI 엔지니어 문승기의 포트폴리오입니다.',
  home = false,
  image = '/og-default.png',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content={`default-src 'self'; script-src 'self' 'sha256-${motionFlagHash}'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self' https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'`} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <script is:inline set:html={motionFlagSource}></script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/PretendardVariable-subset.woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">본문으로 바로가기</a>
    <Header home={home} />
    <main id="main-content"><slot /></main>
    <Footer />
    <EmailDialog />
    <script is:inline defer src="/scripts/section-navigation.js"></script>
    <script is:inline defer src="/scripts/reveal-on-view.js"></script>
  </body>
</html>
