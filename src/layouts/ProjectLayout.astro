---
/**
 * 프로젝트 상세 — 원본 포트폴리오의 쪽 구성(표지 → 제안 배경 → 기획 의도 → 구조 → 주요 기능 → 고려사항 → 시연 → 회고)을 그대로 따른다.
 * 섹션 번호는 원본 순서이며, 고려사항 제목은 원본의 질문형 문장을 그대로 쓴다.
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import MediaImage from '../components/project/MediaImage.astro';
import ShiftPairs from '../components/project/ShiftPairs.astro';
import MediaLightbox from '../components/project/MediaLightbox.astro';
import { getMedia } from '../data/media';
import { profile } from '../data/profile';

/** 세로로 긴 화면(휴대폰 캡처·세로 영상)인지 — 높이로 묶어 가로로 나열하기 위해 */
const isPortrait = (src?: string) => { const m = getMedia(src); return m ? m.height > m.width * 1.15 : false; };
const showLink = (url: string) => decodeURIComponent(url).replace(/^https?:\/\//, '');

interface Props {
  project: CollectionEntry<'projects'>;
  previous?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}
const { project, previous, next } = Astro.props;
const data = project.data;
/** 제안 배경을 "이미지 있는 항목 + 뒤따르는 글만 있는 항목들" 단위로 묶어 한 행(이미지 좌 · 글 우)으로 만든다 */
type Evidence = (typeof project.data.background)[number];
const evidenceRows = project.data.background.reduce<{ media?: Evidence['media']; notes: Evidence[] }[]>((rows, item) => {
  if (item.media || rows.length === 0) rows.push({ media: item.media, notes: [] });
  rows[rows.length - 1].notes.push(item);
  return rows;
}, []);
const featureRows = project.data.featureGroups.filter((group) => group.media.length > 0);
const featureNotes = project.data.featureGroups.filter((group) => group.media.length === 0);
const structureLabel = data.architecture ? '시스템 아키텍처' : '서비스 흐름 설계';
const sections = [
  { id: 'project-background', label: '배경', title: '제안 배경' },
  { id: 'project-intent', label: '기획 의도', title: '기획 의도' },
  { id: 'project-structure', label: '구조', title: structureLabel },
  { id: 'project-features', label: '주요 기능', title: '주요 기능' },
  { id: 'project-considerations', label: '고려사항', title: '주요 고려사항' },
  { id: 'project-demo', label: '시연', title: '시연' },
  { id: 'project-retrospective', label: '회고', title: '회고' },
];
const numbered = (index: number) => String(index + 1).padStart(2, '0');
---

<BaseLayout title={`${data.title} · 문승기 포트폴리오`} description={data.summary}>
  <article>
    <section class="project-hero-band section--inverse">
    <div class="project-hero container">
      <nav class="breadcrumb" aria-label="이동 경로">
        <ol>
          <li><a href="/">홈</a></li>
          <li><a href="/#projects">프로젝트</a></li>
          <li><span aria-current="page">{data.title}</span></li>
        </ol>
      </nav>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="detail-index">프로젝트 <span>{String(data.order).padStart(2, '0')}</span></p>
          <h1>{data.title}</h1>
          <p class="subtitle">{data.subtitle}</p>
          <p class="summary">{data.summary}</p>
          <div class="actions">
            {data.githubUrl && <a class="button" href={data.githubUrl} target="_blank" rel="noreferrer">GitHub 저장소 ↗</a>}
            {data.demoUrl && <a class="button secondary" href={data.demoUrl} target="_blank" rel="noreferrer">서비스 보기 ↗</a>}
          </div>
        </div>
        <dl class="project-meta surface">
          <div><dt>기간</dt><dd>{data.period}</dd></div>
          <div><dt>역할</dt><dd>{data.role}</dd></div>
          <div><dt>플랫폼</dt><dd>{data.platform}</dd></div>
          <div><dt>결과</dt><dd>{data.result}</dd></div>
          {data.githubUrl && <div><dt>GitHub</dt><dd><a class="meta-link" href={data.githubUrl} target="_blank" rel="noreferrer">{data.githubUrl.replace(/^https?:\/\//, '')}</a></dd></div>}
          <div><dt>기술</dt><dd><ul class="skill-chips" aria-label="사용 기술">{data.skills.map((skill) => <li>{skill}</li>)}</ul></dd></div>
        </dl>
      </div>
      <div class="hero-media">
        <MediaImage src={data.heroMedia.src!} alt={data.heroMedia.alt} caption={data.heroMedia.caption} loading="eager" />
      </div>
    </div>
    </section>

    <nav class="project-toc container" aria-label="프로젝트 목차" data-section-navigation="project">
      {sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
    </nav>

    <!-- 01 제안 배경 -->
    <section id="project-background" class="section container case-study-section">
      <div class="section-heading">
        <p class="section-kicker"><span class="section-number">01</span> 배경</p>
        <h2>{data.title}의 제안 배경</h2>
      </div>
      <div class="evidence-rows">
        {evidenceRows.map((row) => (
          <article class:list={['evidence-row', { 'evidence-row--illustration': row.notes.length > 1 }]}>
            {row.media && <div class="evidence-media"><MediaImage src={row.media.src} alt={row.media.alt} caption={row.media.caption} /></div>}
            <div class="evidence-notes">
              {row.notes.map((item) => (
                <div class="evidence">
                  {item.heading && <h3>{item.heading}</h3>}
                  {item.points.length > 0 && <ul>{item.points.map((point) => <li>{point}</li>)}</ul>}
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 02 기획 의도 -->
    <section id="project-intent" class="section section--alt case-study-section">
      <div class="container">
        <div class="section-heading">
          <p class="section-kicker"><span class="section-number">02</span> 기획 의도</p>
          <h2>{data.title}의 기획 의도</h2>
        </div>
        <blockquote class="intent-quote"><p>“{data.intent.quote}”</p></blockquote>
        <ShiftPairs pairs={data.intent.pairs} beforeLabel="기존" afterLabel="제안" />
      </div>
    </section>

    <!-- 03 구조 -->
    <section id="project-structure" class="section container case-study-section">
      <div class="section-heading">
        <p class="section-kicker"><span class="section-number">03</span> 구조</p>
        <h2>{data.title}의 {structureLabel}</h2>
      </div>
      {data.architecture && (
        <div class="structure-grid">
          <MediaImage src={data.architecture.media.src} alt={data.architecture.media.alt} caption={data.architecture.media.caption} />
          <dl class="stack">
            {data.architecture.stack.map((group) => (
              <div><dt>{group.label}</dt><dd><ul class="skill-chips">{group.items.map((item) => <li>{item}</li>)}</ul></dd></div>
            ))}
          </dl>
        </div>
      )}
      {data.flowDesign && (
        <div class="structure-grid structure-grid--flow">
          <MediaImage src={data.flowDesign.media.src} alt={data.flowDesign.media.alt} caption={data.flowDesign.media.caption} />
          <ol class="principles">
            {data.flowDesign.principles.map((principle, index) => (
              <li><span class="principle-num">{index + 1}</span><div><h3>{principle.title}</h3><p>{principle.note}</p></div></li>
            ))}
          </ol>
        </div>
      )}
    </section>

    <!-- 04 주요 기능 -->
    <section id="project-features" class="section section--alt case-study-section">
      <div class="container">
        <div class="section-heading">
          <p class="section-kicker"><span class="section-number">04</span> 주요 기능</p>
          <h2>{data.title}의 주요 기능</h2>
        </div>
        <div class="feature-rows">
          {featureRows.map((group) => {
            const portrait = group.media.every((media) => isPortrait(media.src));
            const [primary, ...more] = group.media;
            return (
              <article class="feature-row">
                <div class:list={['feature-shots', { 'feature-shots--portrait': portrait }]} data-count={group.media.length}>
                  {portrait ? (
                    group.media.map((media) => <MediaImage src={media.src} alt={media.alt} caption={media.caption} />)
                  ) : (
                    <>
                      <MediaImage src={primary.src} alt={primary.alt} caption={primary.caption} />
                      {more.length > 0 && (
                        <div class="feature-shots__more">
                          {more.map((media) => <MediaImage src={media.src} alt={media.alt} caption={media.caption} fit="16 / 10" />)}
                        </div>
                      )}
                    </>
                  )}
                </div>
                <div class="feature-copy">
                  <h3>{group.audience}</h3>
                  <ul>{group.points.map((point) => <li>{point}</li>)}</ul>
                </div>
              </article>
            );
          })}
          {featureNotes.length > 0 && (
            <div class="feature-text-grid">
              {featureNotes.map((group) => (
                <article class="feature-note">
                  <div class="feature-copy">
                    <h3>{group.audience}</h3>
                    <ul>{group.points.map((point) => <li>{point}</li>)}</ul>
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- 05 주요 고려사항 -->
    <section id="project-considerations" class="section container case-study-section">
      <div class="section-heading">
        <p class="section-kicker"><span class="section-number">05</span> 고려사항</p>
        <h2>주요 고려사항</h2>
      </div>
      <div class="considerations">
        {data.considerations.map((item, index) => (
          <article class:list={['consideration', `consideration--${item.layout}`]}>
            <header class="consideration-head">
              <p class="consideration-index">주요 고려사항 {index + 1}</p>
              <h3 class="consideration-question">{item.question}</h3>
              {item.quote && <p class="consideration-quote">“{item.quote}”</p>}
            </header>
            <div class="consideration-body">
            {item.media.length > 0 && (
              <div class="consideration-media" data-count={item.media.length}>
                {item.media.map((media) => <MediaImage src={media.src} alt={media.alt} caption={media.caption} />)}
              </div>
            )}
            <div class="consideration-text">
            {item.table && (
              <dl class="role-table">
                {item.table.map((row) => <div><dt>{row.label}</dt><dd><ul>{row.items.map((cell) => <li>{cell}</li>)}</ul></dd></div>)}
              </dl>
            )}
            <div class="shift-columns">
              {item.problems.length > 0 && (
                <div class="shift-col shift-col--before">
                  <h4>{item.problemsTitle ?? '기존 문제점'}</h4>
                  <ul>{item.problems.map((point) => <li>{point}</li>)}</ul>
                </div>
              )}
              {item.approach.length > 0 && (
                <div class="shift-col shift-col--after">
                  <h4>{item.approachTitle ?? '접근 방식'}</h4>
                  <ul>{item.approach.map((point) => <li>{point}</li>)}</ul>
                </div>
              )}
            </div>
            </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 06 시연 -->
    <section id="project-demo" class="section section--alt case-study-section">
      <div class="container">
        <div class="section-heading">
          <p class="section-kicker"><span class="section-number">06</span> 시연</p>
          <h2>시연 영상</h2>
          <p>{data.demo.note} <a class="original-link" href={profile.contact.portfolioOriginal} target="_blank" rel="noreferrer">원본 포트폴리오(미리캔버스)에서 보기 ↗</a></p>
        </div>
        {data.demo.media.length > 0 ? (
          <div class:list={['media-grid', { 'media-grid--portrait': data.demo.media.every((asset) => isPortrait(asset.src)) }]} data-count={data.demo.media.length}>
            {data.demo.media.map((asset, index) => <MediaFrame asset={asset} label={`시연 ${numbered(index)}`} mode="detail" />)}
          </div>
        ) : (
          <p class="demo-empty">{data.githubUrl ? <a href={data.githubUrl} target="_blank" rel="noreferrer">GitHub 저장소에서 실행 방법 보기 ↗</a> : '시연 자료 준비 중'}</p>
        )}
      </div>
    </section>

    <!-- 07 회고 -->
    <section id="project-retrospective" class="section container case-study-section">
      <div class="section-heading">
        <p class="section-kicker"><span class="section-number">07</span> 회고</p>
        <h2>{data.title} 회고</h2>
      </div>
      <nav class="retro-links" aria-label="회고 더보기">
        {data.retrospective.links.velog && <a href={data.retrospective.links.velog} target="_blank" rel="noreferrer"><span>Velog</span>{showLink(data.retrospective.links.velog)} ↗</a>}
        {data.retrospective.links.github && <a href={data.retrospective.links.github} target="_blank" rel="noreferrer"><span>GitHub</span>{showLink(data.retrospective.links.github)} ↗</a>}
      </nav>
      <div class="retro-cards">
        {data.retrospective.sections.map((note) => (
          <article><h3>{note.title}</h3><p>{note.body}</p></article>
        ))}
      </div>
    </section>

    <nav class="project-nav container" aria-label="프로젝트 이동">
      {previous ? <a href={`/projects/${previous.id}/`}><span>← 이전 프로젝트</span><strong>{previous.data.title}</strong></a> : <span></span>}
      {next ? <a class="next" href={`/projects/${next.id}/`}><span>다음 프로젝트 →</span><strong>{next.data.title}</strong></a> : <a class="next" href="/#projects"><span>프로젝트 목록 →</span><strong>전체 보기</strong></a>}
    </nav>
  </article>
  <MediaLightbox />
</BaseLayout>

<style>
  .project-hero-band { background: var(--bg-hero); color: var(--text-hero); }
  .project-hero { padding-block: clamp(2.5rem, 6vw, 5rem) var(--space-16); }
  .breadcrumb { margin-bottom: var(--space-12); }
  .breadcrumb ol { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; color: var(--text-hero-muted); font-size: var(--font-size-utility); list-style: none; }
  .breadcrumb li { display: inline-flex; align-items: center; gap: var(--space-2); }
  .breadcrumb li + li::before { color: var(--text-hero-muted); content: '/'; }
  .breadcrumb a { color: var(--text-hero-muted); font-weight: 700; text-decoration: none; }
  .breadcrumb a:hover { color: var(--text-hero); text-decoration: underline; text-underline-offset: 4px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.7fr); gap: var(--space-10); align-items: end; margin-bottom: var(--space-10); }
  h1 { margin-bottom: var(--space-3); }
  .detail-index { margin-bottom: var(--space-3); color: var(--text-hero-muted); font-size: 0.9rem; font-weight: 700; }
  .detail-index span, .section-number { margin-right: var(--space-2); font-family: var(--font-mono); font-size: var(--font-size-utility); letter-spacing: 0.06em; }
  .subtitle { margin-bottom: var(--space-5); color: var(--text-hero); font-size: clamp(1.15rem, 2.5vw, 1.6rem); font-weight: 750; }
  .summary { max-width: 46rem; margin-bottom: var(--space-6); color: var(--text-hero-muted); font-size: 1.08rem; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .project-meta { margin: 0; padding: var(--space-6); color: var(--text-primary); }
  .project-meta div { display: grid; grid-template-columns: 4.5rem 1fr; gap: var(--space-3); padding: var(--space-3) 0; }
  .project-meta div + div { border-top: 1px solid var(--border-hair); }
  .meta-link { color: var(--text-accent); font-family: var(--font-mono); font-size: 0.85rem; overflow-wrap: anywhere; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  dt { color: var(--text-muted); font-family: var(--font-sans); font-size: var(--font-size-utility); font-weight: 700; }
  dd { margin: 0; font-size: 0.9rem; font-weight: 650; }
  .skill-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .skill-chips li { padding: 0.25rem 0.55rem; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; line-height: 1.4; }
  .hero-media { max-width: 64rem; }
  .hero-media :global(.media-image--portrait) { max-width: 26rem; }
  .project-toc { position: sticky; z-index: 10; top: calc(var(--header-height) - 1px); display: flex; gap: var(--space-2); overflow-x: auto; margin-bottom: var(--space-4); padding-block: var(--space-3); border-bottom: 1px solid var(--border-hair); background: var(--bg-page); scrollbar-width: thin; }
  .project-toc a { flex: 0 0 auto; padding: 0.45rem 0.7rem; border-radius: var(--radius-sm); color: var(--text-secondary); font-size: var(--font-size-utility); font-weight: 700; text-decoration: none; }
  .project-toc a:hover, .project-toc a[aria-current="location"] { background: var(--navigation-active-bg); color: var(--navigation-active-text); }
  .case-study-section { scroll-margin-top: calc(var(--header-height) + 3.5rem); }
  .section-heading h2 { margin-bottom: 0; }

  /* 01 배경 — 근거 행: 이미지 좌 · 그 이미지에 대한 설명 우 */
  .evidence-rows { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); }
  .evidence-row { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 1.1fr); gap: var(--space-8); align-items: center; }
  .evidence-row + .evidence-row { padding-top: clamp(1.5rem, 3vw, 2.5rem); border-top: 1px solid var(--border-hair); }
  .evidence-media { max-width: 28rem; min-width: 0; }
  .evidence-row--illustration { grid-template-columns: minmax(0, 18rem) minmax(0, 1fr); align-items: start; }
  .evidence-row--illustration .evidence-media { max-width: 18rem; }
  .evidence-notes { display: grid; gap: var(--space-5); min-width: 0; max-width: 40rem; }
  .evidence { display: grid; align-content: start; gap: var(--space-3); min-width: 0; }
  .evidence h3 { font-size: 1.05rem; padding-bottom: var(--space-2); border-bottom: 1px solid var(--border-hair); }
  .evidence ul { margin: 0; padding-left: 1.1rem; color: var(--text-secondary); font-size: 0.92rem; display: grid; gap: var(--space-2); }
  .evidence li:first-child:not(:only-child) { list-style: none; margin-left: -1.1rem; color: var(--text-primary); }

  /* 02 기획 의도 */
  .intent-quote { margin: 0 0 var(--space-8); }
  .intent-quote p { margin: 0; max-width: 40ch; font-size: clamp(1.35rem, 2.8vw, 2rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.35; text-wrap: balance; }

  /* 03 구조 */
  .structure-grid { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(16rem, 0.8fr); gap: var(--space-8); align-items: start; }
  .structure-grid--flow { grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 1fr); }
  .stack { margin: 0; display: grid; gap: var(--space-4); }
  .stack div { display: grid; gap: var(--space-2); }
  .stack dt { padding-bottom: var(--space-2); border-bottom: 1px solid var(--border-hair); color: var(--text-primary); font-size: 0.95rem; }
  .principles { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--space-4); }
  .principles li { display: grid; grid-template-columns: 2rem 1fr; gap: var(--space-3); }
  .principle-num { font-family: var(--font-mono); font-weight: 600; color: var(--text-accent); padding-top: 0.15rem; }
  .principles h3 { font-size: 1.05rem; margin-bottom: var(--space-1); }
  .principles p { margin: 0; padding: var(--space-2) var(--space-3); background: var(--bg-page); color: var(--text-secondary); font-size: 0.92rem; border-radius: var(--radius-sm); }

  /* 04 주요 기능 — 기능 행: 핵심 화면 좌 · 그 화면의 기능 설명 우. 보조 화면은 첫 장 아래 작게(크게 보기) */
  .feature-rows { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .feature-row { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 1fr); gap: var(--space-8); align-items: center; }
  .feature-row + .feature-row { padding-top: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--border-hair); }
  .feature-shots { display: grid; gap: var(--space-3); min-width: 0; }
  /* 세로로 긴 첫 화면(예: 사건 접수 1920×1927)은 높이를 34rem으로 제한. width 100%를 유지해 로드 전에도 자리를 잡는다(CLS 0) */
  .feature-shots:not(.feature-shots--portrait) > :global(.media-image:first-child img) { max-height: 34rem; object-fit: contain; }
  .feature-shots__more { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
  .feature-shots--portrait { grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); align-items: start; }
  .feature-shots--portrait :global(.media-image) { --thumb-h: 22rem; }
  .feature-copy { min-width: 0; max-width: 40rem; }
  .feature-copy h3 { font-size: 1.15rem; margin-bottom: var(--space-3); padding-bottom: var(--space-2); border-bottom: 1px solid var(--border-hair); }
  .feature-copy ul { margin: 0; padding-left: 1.1rem; color: var(--text-secondary); font-size: 0.95rem; display: grid; gap: var(--space-2); }
  .feature-text-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
